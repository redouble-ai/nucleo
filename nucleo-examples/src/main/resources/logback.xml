<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging for the examples: the runtime at INFO, so a run shows which model served each
  grade and how each job ended beside what the program prints; everything else at WARN.
-->
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>
    <logger name="ai.redouble" level="INFO"/>
    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
